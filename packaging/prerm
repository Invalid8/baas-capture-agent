#!/bin/sh
set -e
if [ "$1" = "remove" ]; then
    for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
        systemctl --user -M "$user@" stop baas-capture-agent.service >/dev/null 2>&1 || true
    done
    systemctl --global disable baas-capture-agent.service >/dev/null 2>&1 || true
fi
exit 0

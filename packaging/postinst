#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    systemctl --global enable baas-capture-agent.service >/dev/null 2>&1 || true
    for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
        systemctl --user -M "$user@" daemon-reload >/dev/null 2>&1 || true
        systemctl --user -M "$user@" restart baas-capture-agent.service >/dev/null 2>&1 || true
    done
fi
exit 0
